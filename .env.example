# ============================================================
# Modelo das variáveis de ambiente. Copie para .env.local (que está no
# .gitignore) para rodar as rotas de API em localhost, e cadastre as mesmas
# em: Vercel -> Settings -> Environment Variables.
# Este arquivo NÃO leva valor nenhum: só os nomes e onde achar cada um.
# ============================================================

# ---------- Meta (Conversions API) ----------
# Events Manager -> dataset 2445872572575348 -> Settings -> Conversions API
# -> Generate access token. Sem ele /api/meta-capi responde erro e o funil
# fica só com o pixel do navegador.
META_CAPI_ACCESS_TOKEN=

# Opcional. COM ele preenchido os eventos vão para a aba Testar eventos e NÃO
# contam como conversão. Esvazie quando for pra valer.
META_TEST_EVENT_CODE=

# Segredo da rota manual /api/venda-fechada. Invente uma string longa e
# aleatória; não reaproveite senha de outra coisa.
VENDA_TOKEN=

# ---------- Supabase (tabela leads, rota /api/lead) ----------
# Supabase -> Settings -> API.
# A service role key é chave de administrador: ela ignora o RLS, e é por isso
# que a rota /api/lead existe. NUNCA coloque em NEXT_PUBLIC_*, nunca no client.
# Antes do primeiro envio, rode supabase/leads.sql no SQL Editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Aviso de lead novo (Resend) ----------
# Opcional: sem estas, o lead é gravado do mesmo jeito e só o e-mail é pulado.
# A chave sai de resend.com -> API Keys.
RESEND_API_KEY=
# Para onde vai o aviso.
LEAD_EMAIL_TO=
# Remetente. O padrão do código (onboarding@resend.dev) só entrega no e-mail
# dono da conta Resend, o que basta para avisar você mesmo. Para mandar para
# outro endereço, verifique um domínio na Resend e troque aqui.
LEAD_EMAIL_FROM=

# ---------- Mercado Pago (propostas) ----------
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# ---------- Mixpanel (script de relatório) ----------
# mixpanel.com -> engrenagem -> Project Settings -> Access Keys (projeto 4043044).
# Usado só por scripts/mixpanel-funil.mjs, fora do site.
MIXPANEL_API_SECRET=
